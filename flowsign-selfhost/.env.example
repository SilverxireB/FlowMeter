# Yönetici parolası (ZORUNLU) — /login ekranında sorulur.
SIGN_ADMIN_PASSWORD=degistir-beni

# Verilerin yazılacağı klasör (opsiyonel; varsayılan: uygulama klasöründe ./data)
# Yedek almak = bu klasörü kopyalamak.
# SIGN_DATA_DIR=/var/lib/flowsign/data

# Sunucu portu `npm run start -p ...` ile ya da standalone'da PORT ile verilir:
# PORT=3090

# Dış kimlik kapısı (opsiyonel): tanımlıysa kullanıcı adı + parola bu adrese
# POST edilir ({"kullanici","parola"} → {"ok":true,"ad","rol"}); LDAP'ı bilen
# kurum uygulaması burayı karşılar. Ulaşılamazsa yerel hesaplar çalışmaya
# devam eder. Ayrıntı: README "Dış kimlik" + DEVIR-NOTU.md §7.
# DIS_KIMLIK_URL=http://ic-sunucu/api/flowsign-login
