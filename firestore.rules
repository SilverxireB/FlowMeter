rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sunumlar: herkes okuyabilir (izleyiciler auth'suz katılır),
    // sadece sahibi yazabilir.
    match /presentations/{presentationId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      // Katılımcılar: izleyici kendi voterId dokümanını oluşturur/günceller
      // (nickname). Silme sadece sunum sahibinde ("yeni oturum" ile temizleme).
      match /participants/{participantId} {
        allow read: if true;
        allow create, update: if request.resource.data.keys()
            .hasOnly(['nickname', 'emoji', 'avatarSeed', 'joinedAt'])
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() <= 30;
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/presentations/$(presentationId))
             .data.ownerId == request.auth.uid;
      }

      // Tepkiler (uçuşan emojiler): herkes ekleyebilir, sadece izinli emojiler.
      match /reactions/{reactionId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['emoji', 'createdAt'])
          && request.resource.data.emoji in ['❤️', '👍', '😂', '😮', '🎉'];
        allow update, delete: if false;
      }

      // Canlı sohbet: izleyici mesaj ekler (create-only, 200 karakter),
      // silme (moderasyon) sadece sunum sahibinde.
      match /messages/{messageId} {
        allow read: if true;
        allow create: if request.resource.data.keys()
            .hasOnly(['text', 'voterId', 'nickname', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 200
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() <= 30;
        allow update: if false;
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/presentations/$(presentationId))
             .data.ownerId == request.auth.uid;
      }

      // Q&A soruları: izleyici ekler ve upvote eder (+1'den fazla artırılamaz),
      // moderasyon (gizle/sil) sadece sahibinde.
      match /questions/{questionId} {
        allow read: if true;
        allow create: if request.resource.data.keys()
            .hasOnly(['text', 'voterId', 'upvotes', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 250
          && request.resource.data.upvotes == 0;
        allow update: if
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes'])
            && request.resource.data.upvotes == resource.data.upvotes + 1)
          || (request.auth != null
            && get(/databases/$(database)/documents/presentations/$(presentationId))
               .data.ownerId == request.auth.uid);
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/presentations/$(presentationId))
             .data.ownerId == request.auth.uid;
      }

      match /slides/{slideId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null
          && get(/databases/$(database)/documents/presentations/$(presentationId))
             .data.ownerId == request.auth.uid;

        // Oylar: herkes ekleyebilir (anonim izleyici), ama asla
        // değiştirilemez/silinemez — sadece create.
        match /responses/{responseId} {
          allow read: if true;
          allow create: if request.resource.data.keys()
              .hasOnly(['voterId', 'value', 'createdAt'])
            && request.resource.data.voterId is string;
          allow update: if false;
          // Sadece sunum sahibi silebilir ("cevapları sıfırla")
          allow delete: if request.auth != null
            && get(/databases/$(database)/documents/presentations/$(presentationId))
               .data.ownerId == request.auth.uid;
        }
      }
    }

    // Join kodu -> sunum ID lookup tablosu.
    match /joinCodes/{code} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if false;
    }
  }
}
