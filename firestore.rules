rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Yönetici: bootstrap e-posta (Google token'ından) VEYA users kaydında role=admin.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'doganbaharozu@gmail.com'
        || get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('role', '') == 'admin'
      );
    }

    // Kullanıcı kayıt defteri: girişte herkes KENDİ kaydını yazar ama role
    // alanına dokunamaz (kendini admin yapamaz); rol atama/silme sadece yönetici.
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.get('role', 'user') == 'user';
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.get('role', 'user') == resource.data.get('role', 'user'));
      allow delete: if isAdmin();
    }

    // Sunumlar: herkes okuyabilir (izleyiciler auth'suz katılır),
    // sadece sahibi yazabilir.
    match /presentations/{presentationId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      // Katılımcılar: izleyici kendi voterId dokümanını oluşturur/günceller
      // (nickname). Silme sadece sunum sahibinde ("yeni oturum" ile temizleme).
      match /participants/{participantId} {
        allow read: if true;
        allow create, update: if request.resource.data.keys()
            .hasOnly(['nickname', 'emoji', 'avatarSeed', 'joinedAt', 'sessionId'])
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() <= 30;
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/presentations/$(presentationId))
             .data.ownerId == request.auth.uid;
      }

      // Geçmiş oturum arşivi (yalnızca zaman damgaları): sadece sunum sahibi yazar.
      match /sessions/{sessionId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null
          && get(/databases/$(database)/documents/presentations/$(presentationId))
             .data.ownerId == request.auth.uid;
      }

      // Tepkiler (uçuşan emojiler): herkes ekleyebilir, sadece izinli emojiler.
      // Değiştirilemez; silme sadece sunum sahibinde (temizlik / yeni oturum).
      match /reactions/{reactionId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['emoji', 'createdAt'])
          && request.resource.data.emoji in ['❤️', '👍', '😂', '😮', '🎉'];
        allow update: if false;
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/presentations/$(presentationId))
             .data.ownerId == request.auth.uid;
      }

      // Canlı sohbet: izleyici mesaj ekler (create-only, 200 karakter),
      // silme (moderasyon) sadece sunum sahibinde.
      match /messages/{messageId} {
        allow read: if true;
        allow create: if request.resource.data.keys()
            .hasOnly(['text', 'voterId', 'nickname', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 200
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() <= 30;
        allow update: if false;
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/presentations/$(presentationId))
             .data.ownerId == request.auth.uid;
      }

      // Q&A soruları: izleyici ekler ve upvote eder (+1'den fazla artırılamaz),
      // moderasyon (gizle/sil) sadece sahibinde.
      match /questions/{questionId} {
        allow read: if true;
        allow create: if request.resource.data.keys()
            .hasOnly(['text', 'voterId', 'upvotes', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 250
          && request.resource.data.upvotes == 0;
        allow update: if
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes'])
            && request.resource.data.upvotes == resource.data.upvotes + 1)
          || (request.auth != null
            && get(/databases/$(database)/documents/presentations/$(presentationId))
               .data.ownerId == request.auth.uid);
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/presentations/$(presentationId))
             .data.ownerId == request.auth.uid;
      }

      match /slides/{slideId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null
          && get(/databases/$(database)/documents/presentations/$(presentationId))
             .data.ownerId == request.auth.uid;

        // Oylar: herkes ekleyebilir (anonim izleyici), ama asla
        // değiştirilemez/silinemez — sadece create.
        // SUNUCU TARAFI KAPILAR (istemci saati/kurcalama aşamaz):
        //  - sunum bitmişse / oylama kapalıysa oy YOK
        //  - oy, sunumun AKTİF oturumuna ait olmalı (eski oturum telefonu yazamaz)
        //  - quiz/quiz-type: geri sayım başlamamışsa ya da süre dolmuşsa oy YOK
        //    (+1.5 sn ağ gecikmesi toleransı)
        match /responses/{responseId} {
          function pres() {
            return get(/databases/$(database)/documents/presentations/$(presentationId)).data;
          }
          function slideData() {
            return get(/databases/$(database)/documents/presentations/$(presentationId)/slides/$(slideId)).data;
          }
          function sessionOk() {
            return !('sessionId' in pres())
              || request.resource.data.get('sessionId', '') == pres().sessionId;
          }
          function quizWindowOpen() {
            let s = slideData();
            return !(s.type in ['quiz', 'quiz-type'])
              || (s.get('quizStartedAt', null) != null
                  && request.time.toMillis() < s.quizStartedAt.toMillis()
                     + s.get('settings', {}).get('timeLimit', s.type == 'quiz' ? 20 : 30) * 1000
                     + 1500);
          }
          allow read: if true;
          allow create: if request.resource.data.keys()
              .hasOnly(['voterId', 'value', 'createdAt', 'sessionId'])
            && request.resource.data.voterId is string
            && pres().get('ended', false) != true
            && pres().get('votingClosed', false) != true
            && sessionOk()
            && quizWindowOpen();
          allow update: if false;
          // Sadece sunum sahibi silebilir ("cevapları sıfırla")
          allow delete: if request.auth != null
            && get(/databases/$(database)/documents/presentations/$(presentationId))
               .data.ownerId == request.auth.uid;
        }
      }
    }

    // ── FlowWall: canlı etkinlik foto/video duvarı ──────────────────────────
    // Duvar: herkes okur (perde + misafir), sadece sahibi yazar.
    match /walls/{wallId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      // Medya: misafir (anonim) ekler; byte'lar Cloudinary'de, burada metadata.
      // Moderasyon açıkken status 'pending' olmak ZORUNDA (kendi kendini onaylayamaz).
      // SUNUCU KAPILARI (istemci kontrolü aşılamaz): kapalı duvara yazma YOK,
      // url yalnız Cloudinary, nickname ≤30, aktif oturum eşleşmesi, video süresi
      // duvar limitine bağlı (+3 sn tolerans).
      match /media/{mediaId} {
        function wall() {
          return get(/databases/$(database)/documents/walls/$(wallId)).data;
        }
        function mediaShapeOk() {
          return request.resource.data.keys().hasOnly(
              ['voterId','nickname','type','cloudinaryId','url','w','h','durationMs','status','likes','sessionId','createdAt'])
            && request.resource.data.voterId is string
            && request.resource.data.type in ['image','video']
            && request.resource.data.url is string
            && request.resource.data.url.matches('https://res\\.cloudinary\\.com/.*')
            && (!('nickname' in request.resource.data)
                || (request.resource.data.nickname is string
                    && request.resource.data.nickname.size() <= 30))
            && request.resource.data.get('sessionId', '') == wall().get('sessionId', '')
            && request.resource.data.get('likes', 0) == 0
            && request.resource.data.status ==
               (wall().get('moderation', false) == true ? 'pending' : 'approved');
        }
        allow read: if true;
        allow create: if mediaShapeOk() && (
          // Sahip kendi duvarına her zaman ekleyebilir (kapalıyken de)
          (request.auth != null && wall().ownerId == request.auth.uid)
          // Misafir: duvar açıkken + video kurallarına uyarak
          || (wall().get('closed', false) != true
              && (request.resource.data.type == 'image'
                  || (wall().get('allowVideo', true) == true
                      && request.resource.data.get('durationMs', 0) <= (wall().get('videoLimitSec', 60) + 3) * 1000)))
        );
        // Beğeni: herkes yalnız 'likes' alanını +1 artırabilir (misafir ❤);
        // diğer tüm değişiklikler (moderasyon/onayla/reddet) ve silme sadece sahibinde.
        allow update: if
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
            && request.resource.data.likes == resource.data.get('likes', 0) + 1)
          || (request.auth != null && wall().ownerId == request.auth.uid);
        allow delete: if request.auth != null
          && wall().ownerId == request.auth.uid;
      }

      // Tepkiler (misafir emoji/kalp yağmuru → perde): herkes ekler, sadece
      // izinli emojiler. Değiştirilemez; silme (temizlik) sadece duvar sahibinde.
      match /reactions/{reactionId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['emoji', 'createdAt'])
          && request.resource.data.emoji in ['❤️', '👏', '🎉', '😍', '🔥', '😮'];
        allow update: if false;
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/walls/$(wallId)).data.ownerId == request.auth.uid;
      }

      // Dilekler (misafir yazılı not → perdede dilek bandı): herkes ekler
      // (1–140 karakter). Moderasyon açıkken status 'pending' ZORUNDA (kendini
      // onaylayamaz). Onaylama/reddetme/silme sadece duvar sahibinde.
      match /wishes/{wishId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['text', 'nickname', 'voterId', 'status', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 140
          && request.resource.data.voterId is string
          && get(/databases/$(database)/documents/walls/$(wallId)).data.get('wishesEnabled', true) == true
          && request.resource.data.status ==
             (get(/databases/$(database)/documents/walls/$(wallId)).data.get('moderation', false) == true ? 'pending' : 'approved');
        allow update, delete: if request.auth != null
          && get(/databases/$(database)/documents/walls/$(wallId)).data.ownerId == request.auth.uid;
      }

      // Yarışma oyları: misafir KENDİ oyunu yazar (doc id = voterId → kişi başı
      // tek, değiştirilebilir). Aktif yarışmanın contestId'si zorunlu; süre
      // dolduysa oy YOK (+2 sn ağ toleransı — kokpit kapatmasa bile). Silme sahibinde.
      match /contestVotes/{voterId} {
        function w() { return get(/databases/$(database)/documents/walls/$(wallId)).data; }
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasOnly(['mediaId','contestId','createdAt'])
          && request.resource.data.mediaId is string
          && w().get('contest', null) != null
          && w().contest.get('status','') == 'running'
          && request.resource.data.contestId == w().contest.id
          && (w().contest.get('endsAt', null) == null
              || request.time.toMillis() < w().contest.endsAt.toMillis() + 2000);
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/walls/$(wallId)).data.ownerId == request.auth.uid;
      }

      // Çekiliş kayıtları: misafir isim+sicil girer (doc id = sicil → aynı sicil
      // tek kayıt). Yalnız kayıt türünde + kayıt açıkken. GÜNCELLEME yalnız aynı
      // cihazdan (voterId eşleşmeli) — misafir başkasının kaydını ezemez. Silme sahibinde.
      match /raffleEntries/{sicil} {
        function w() { return get(/databases/$(database)/documents/walls/$(wallId)).data; }
        function entryShapeOk() {
          return request.resource.data.keys().hasOnly(['name','sicil','voterId','createdAt'])
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
            && request.resource.data.sicil is string
            && request.resource.data.sicil.size() >= 1 && request.resource.data.sicil.size() <= 40
            && request.resource.data.voterId is string;
        }
        function guestWindowOpen() {
          return w().get('raffle', null) != null
            && w().raffle.get('type','') == 'registration'
            && w().raffle.get('registerOpen', true) == true;
        }
        allow read: if true;
        allow create: if entryShapeOk()
          && ((request.auth != null && w().ownerId == request.auth.uid) // toplu liste (Excel)
              || guestWindowOpen());
        allow update: if entryShapeOk()
          && ((request.auth != null && w().ownerId == request.auth.uid)
              || (guestWindowOpen()
                  && request.resource.data.voterId == resource.data.get('voterId', '')));
        allow delete: if request.auth != null && w().ownerId == request.auth.uid;
      }

      // Çekim kayıt defteri (denetim): kazananlar + havuz boyu. Yalnız sahip yazar.
      match /draws/{drawId} {
        allow read: if true;
        allow create, delete: if request.auth != null
          && get(/databases/$(database)/documents/walls/$(wallId)).data.ownerId == request.auth.uid;
        allow update: if false;
      }
    }

    // Join kodu -> sunum/duvar lookup tablosu ({presentationId} veya {id,kind:"wall"}).
    // Oluşturma/silme HEDEFİN SAHİBİNE bağlı — başka bir hesap, bir etkinliğin
    // kodunu silip katılımı kıramaz. (Parent doküman koddan ÖNCE yaratılır;
    // silmede batch içi get() ön-durumu okur → sahiplik kontrolü geçer.)
    match /joinCodes/{code} {
      function ownsWall(id) {
        return get(/databases/$(database)/documents/walls/$(id)).data.ownerId == request.auth.uid;
      }
      function ownsDeck(id) {
        return get(/databases/$(database)/documents/presentations/$(id)).data.ownerId == request.auth.uid;
      }
      allow read: if true;
      allow create: if request.auth != null && (
        (request.resource.data.keys().hasOnly(['id', 'kind'])
          && request.resource.data.kind == 'wall'
          && ownsWall(request.resource.data.id))
        || (request.resource.data.keys().hasOnly(['presentationId'])
          && ownsDeck(request.resource.data.presentationId))
      );
      allow delete: if request.auth != null && (
        (resource.data.get('kind', '') == 'wall' && ownsWall(resource.data.id))
        || (resource.data.get('kind', '') != 'wall' && ownsDeck(resource.data.presentationId))
      );
      allow update: if false;
    }

    // ── FlowSign (VideoWall): dijital tabela / video-wall CMS ────────────────
    // Config herkes okur (oynatma linki auth'suz açılır), sadece sahibi yazar.
    match /videowalls/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // ── FlowPulse: sürekli nabız/geri bildirim (kiosk + QR, tamamen anonim) ──
    match /pulses/{pulseId} {
      function pulseOwner() {
        return request.auth != null
          && get(/databases/$(database)/documents/pulses/$(pulseId)).data.ownerId == request.auth.uid;
      }
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      // Ham oylar: herkes ekler (anonim) ama değer SORU TİPİNE bağlı doğrulanır
      // (smiley 1–5, nps 0–10, yesno 0/1, choice < seçenek sayısı; tam sayı).
      // get() aynı zamanda ebeveyn pulse'ın varlığını zorlar (yetim yazım yok).
      match /votes/{voteId} {
        function q() {
          return get(/databases/$(database)/documents/pulses/$(pulseId)).data.question;
        }
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['value', 'channel', 'createdAt'])
          && request.resource.data.value is int
          && request.resource.data.channel in ['kiosk', 'qr']
          && (
            (q().type == 'smiley' && request.resource.data.value >= 1 && request.resource.data.value <= 5)
            || (q().type == 'nps' && request.resource.data.value >= 0 && request.resource.data.value <= 10)
            || (q().type == 'yesno' && (request.resource.data.value == 0 || request.resource.data.value == 1))
            || (q().type == 'choice' && request.resource.data.value >= 0
                && request.resource.data.value < q().get('options', []).size())
          );
        allow update: if false;
        allow delete: if pulseOwner();
      }

      // Günlük özet (rollup): oyla birlikte artar. dayId gerçek tarih formatında,
      // alanlar sabit küme, total tam +1 & sum ≤ +10 → yazım başına en fazla tek
      // oyluk etki. (counts/hours iç deltaları rules'ta sınırlanamıyor — görsel
      // grafikleri kirletebilir ama skor/oy sayısı total/sum'dan gelir, dürüst kalır.)
      match /days/{dayId} {
        allow read: if true;
        allow create: if dayId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && exists(/databases/$(database)/documents/pulses/$(pulseId))
          && request.resource.data.keys().hasOnly(['total', 'sum', 'counts', 'hours'])
          && request.resource.data.get('total', 0) == 1
          && request.resource.data.get('sum', 0) >= 0
          && request.resource.data.get('sum', 0) <= 10;
        allow update: if request.resource.data.keys().hasOnly(['total', 'sum', 'counts', 'hours'])
          && request.resource.data.get('total', 0) == resource.data.get('total', 0) + 1
          && request.resource.data.get('sum', 0) >= resource.data.get('sum', 0)
          && request.resource.data.get('sum', 0) <= resource.data.get('sum', 0) + 10;
        allow delete: if pulseOwner();
      }

      // Anonim yorumlar: moderasyon açıkken 'pending' ZORUNDA; yönetim sahibinde.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['text', 'status', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 200
          && request.resource.data.status ==
             (get(/databases/$(database)/documents/pulses/$(pulseId)).data.get('moderation', true) == true ? 'pending' : 'approved');
        allow update, delete: if pulseOwner();
      }
    }
  }
}
