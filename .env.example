# Firebase web app config — Firebase Console > Project Settings > General > Your apps
# Bu değerleri .env.local dosyasına (lokal) ve Vercel > Settings > Environment Variables'a ekle.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# FlowWall medya deposu — Cloudinary (imzasız/unsigned yükleme; backend gerekmez).
# Cloudinary Console > Settings > Upload > "Add upload preset" → Signing Mode: Unsigned.
# Cloud name: Console ana sayfada. (Yalnız FlowWall; FlowMeter kullanmaz.)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# FlowWall KALICI silme (opsiyonel ama önerilir) — Cloudinary Console > API Keys.
# SADECE sunucu tarafı (NEXT_PUBLIC değil!); Vercel'de "Sensitive" açık eklenebilir.
# Tanımlı değilse: kalıcı silme dosyayı Cloudinary'de bırakır, sadece duvar kaydını siler.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
